# Copy this file to .env and replace the placeholders with a disposable,
# confirmed Cognito user from your Amplify sandbox.
CYPRESS_testUserEmail=your-test-user@example.com
CYPRESS_testUserPassword=YourPassword1!

# Set to true only when running the real sign-up E2E test. It creates a user
# and requires the AWS role to allow cognito-idp:AdminConfirmSignUp.
CYPRESS_enableSignUpTests=false

# Optional: use this when the Amplify sandbox uses a non-default AWS CLI profile.
# CYPRESS_awsProfile=your-profile
